{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "wherearethegrants-com",
  "compatibility_date": "2026-08-25",
  "main": "worker.mjs",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".deploy-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "PUBLIC_DATA", "bucket_name": "atlas-raw" }
  ],
  "routes": [
    { "pattern": "wherearethegrants.com", "custom_domain": true },
    { "pattern": "www.wherearethegrants.com", "custom_domain": true }
  ]
}
